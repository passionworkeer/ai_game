// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider = "postgresql"  // 生产环境用 PostgreSQL
  provider = "sqlite"        // 本地开发用 SQLite（无需 Docker）
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  /// 脱敏设备标识：客户端生成 UUID v4，不使用真实 IMEI/GAID
  deviceId   String    @unique
  /// 手机号（可选，账号升级后填写）
  phone      String?   @unique
  /// Apple ID（可选，账号升级后填写）
  appleId    String?   @unique
  /// 微信 union_id（可选）
  unionId    String?   @unique
  /// 昵称（来自客户端同步）
  nickname   String    @default("宝宝")
  /// 云端备份的结构化 profile（JSON）
  profileJson String   @default("{}")
  /// 管理员角色标记
  role        String    @default("user")
  /// 是否被封禁
  isBanned    Boolean   @default(false)
  /// 最后活跃时间
  lastActive  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchases Purchase[]

  @@map("users")
}

model Character {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String
  price        Int
  previewUrl   String?
  assetsUrl    String
  systemPrompt String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases Purchase[]

  @@map("characters")
}

model Purchase {
  id              String    @id @default(uuid())
  userId          String
  characterId     String
  channel         String
  channelOrderId  String?
  amount          Int
  status          String    @default("pending")
  paidAt          DateTime?
  encryptedAesKey String?
  createdAt       DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@unique([userId, characterId])
  @@map("purchases")
}
